<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Dive — {{ issue.date | datefmt }}</title>
<meta name="description" content="A daily digest of saltwater and reef aquarium news. Every item links to its source.">
<style>
  /* Single-theme by choice: white ground, the conventional register for a news
     aggregator. There is deliberately no dark variant — a digest read at 6am on
     a phone should look the same as one read at noon on a desktop. Every colour
     is stated explicitly so the page holds its look on any host background. */
  :root {
    --page:      #ffffff;
    --ground:    #f6f7f8;
    --ink:       #16191d;
    --ink-soft:  #545e69;
    --ink-faint: #8b959f;
    --rule:      #e4e8eb;
    --link:      #0b5fbe;
    --flare:     #b8501f;   /* beat tags only — the one warm note on the page */

    /* One hue per category, matched in weight so the set reads as a system
       rather than a rainbow. Each clears 4.5:1 on white. */
    --c-industry:       #0a6360;  --c-industry-tint:   #ecf4f3;
    --c-husbandry:      #2a6234;  --c-husbandry-tint:  #edf3ee;
    --c-community:      #364a8f;  --c-community-tint:  #ecEEF7;
    --c-livestock:      #8a5512;  --c-livestock-tint:  #f6f1e8;
    --c-wild-reefs:     #1a5182;  --c-wild-reefs-tint: #eaeff5;
    --c-events:         #4b4a6e;  --c-events-tint:     #eeedf4;
    --c-elsewhere:      #545e69;  --c-elsewhere-tint:  #f2f3f5;
  }

  /* Each section sets --hue and --tint once; everything inside reads from them. */
  .sec-industry   { --hue: var(--c-industry);   --tint: var(--c-industry-tint); }
  .sec-husbandry  { --hue: var(--c-husbandry);  --tint: var(--c-husbandry-tint); }
  .sec-community  { --hue: var(--c-community);  --tint: var(--c-community-tint); }
  .sec-livestock  { --hue: var(--c-livestock);  --tint: var(--c-livestock-tint); }
  .sec-wild-reefs { --hue: var(--c-wild-reefs); --tint: var(--c-wild-reefs-tint); }
  .sec-events     { --hue: var(--c-events);     --tint: var(--c-events-tint); }
  .sec-elsewhere  { --hue: var(--c-elsewhere);  --tint: var(--c-elsewhere-tint); }

  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--page); color: var(--ink);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    -webkit-text-size-adjust: 100%;
  }
  .wrap { max-width: 42rem; margin: 0 auto; padding: 2.25rem 1.15rem 4rem; }

  /* -------------------------------- masthead -------------------------------
     The banner carries the wordmark and tagline, so the h1 wraps the image and
     the alt text is the heading — no duplicated text on the page, and screen
     readers still get a real <h1>. */
  header.masthead { margin: 0 0 1.1rem; }
  h1.wordmark { margin: 0; font-size: 0; line-height: 0; }
  h1.wordmark img { display: block; width: 100%; height: auto; border-radius: 8px; }

  /* Drawn stand-in, used only when no banner file is present. Same palette, so
     a missing asset degrades rather than breaks. */
  .banner-fallback {
    border-radius: 8px; padding: 1.5rem 1.4rem 1.6rem;
    background: linear-gradient(155deg, #3585b8 0%, #1d5f92 45%, #102a3f 100%);
    color: #fff;
  }
  .banner-fallback .kicker {
    margin: 0 0 .15rem; font-size: .84rem; font-weight: 700; letter-spacing: -.005em;
  }
  .banner-fallback .name {
    margin: 0; font-size: clamp(2rem, 7vw, 3rem); font-weight: 700;
    letter-spacing: -.035em; line-height: 1;
  }
  .banner-fallback .tagline {
    margin: .5rem 0 0; font-size: .85rem; font-weight: 700; color: rgba(255,255,255,.9);
  }

  .dateline {
    margin: .6rem 0 0; font-size: .79rem; color: var(--ink-faint);
    font-variant-numeric: tabular-nums; padding-bottom: .7rem;
    border-bottom: 1px solid var(--rule);
  }

  /* ---------------------------------- intro --------------------------------
     The one place on the page written to a person rather than assembled from
     a feed. Slightly larger than the story text, so the voice lands before
     the density starts. */
  .intro { margin: 1.3rem 0 1.5rem; font-size: .97rem; line-height: 1.6; }
  .intro p { margin: 0 0 .85rem; }
  .intro p:last-child { margin-bottom: 0; }
  .intro .lead-in { font-weight: 700; color: var(--ink); margin-bottom: .5rem; }
  .intro ul {
    margin: 0 0 .95rem; padding-left: 1.15rem;
    display: grid; gap: .3rem;
  }
  .intro li { color: var(--ink); }
  .intro li.plus { color: var(--ink-soft); }

  /* -------------------------------- sections ------------------------------- */
  .sections { display: grid; gap: .9rem; margin-top: 1.5rem; }
  section.card { background: var(--tint); border-radius: 8px; padding: .95rem 1.05rem 1.05rem; }
  section.card > h2 {
    display: flex; align-items: center; justify-content: space-between; gap: .5rem;
    margin: 0 0 .45rem; padding-bottom: .45rem;
    border-bottom: 1px solid color-mix(in srgb, var(--hue) 20%, transparent);
    font: 700 .69rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .13em; text-transform: uppercase; color: var(--hue);
  }
  section.card > h2 .count {
    font-weight: 700; color: var(--ink-faint); font-variant-numeric: tabular-nums;
  }

  ul.items { list-style: none; margin: 0; padding: 0; }
  li.item { padding: .62rem 0; border-bottom: 1px solid color-mix(in srgb, var(--hue) 13%, transparent); }
  li.item:last-child { border-bottom: none; padding-bottom: 0; }

  a.headline {
    display: block; font-size: .96rem; font-weight: 700; letter-spacing: -.011em;
    line-height: 1.32; color: var(--ink); text-decoration: none; text-wrap: balance;
  }
  a.headline:hover { color: var(--hue); text-decoration: underline; }
  .gist { margin: .26rem 0 0; font-size: .89rem; line-height: 1.48; color: var(--ink-soft); }
  .credit {
    margin: .3rem 0 0; font-size: .755rem; color: var(--ink-faint);
    display: flex; flex-wrap: wrap; gap: .3rem; align-items: center;
  }
  .credit .source { color: var(--hue); font-weight: 700; }
  /* Medium, not section: a duration says "this is a video, and how long" in
     the one place a reader is deciding whether to click. */
  .runtime {
    border: 1px solid color-mix(in srgb, var(--hue) 35%, transparent);
    color: var(--hue); font-size: .6rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    padding: .1rem .32rem; border-radius: 2px;
  }
  /* How many other posts said the same thing. A crude stand-in for the
     clustered "More:" line, and a signal that a story is being widely
     covered rather than mentioned once. */
  .alsoran { color: var(--ink-faint); font-size: .72rem; }
  .beat {
    background: var(--flare); color: #fff; font-size: .6rem; font-weight: 700;
    letter-spacing: .07em; text-transform: uppercase; padding: .1rem .32rem; border-radius: 2px;
  }

  /* --------------------------------- footer -------------------------------- */
  .empty { color: var(--ink-soft); font-style: italic; padding: 2rem 0; }
  footer {
    margin-top: 2.25rem; padding-top: 1rem; border-top: 1px solid var(--rule);
    font-size: .78rem; color: var(--ink-faint); line-height: 1.6;
  }
  footer p { margin: 0 0 .6rem; }
  footer p:last-child { margin-bottom: 0; }
  footer a { color: var(--link); }

  a:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
</style>
</head>
<body>
<div class="wrap">

  <header class="masthead">
    {% if header_image %}
    <h1 class="wordmark">
      <img src="{{ header_image }}" width="954" height="202"
           alt="Daily Dive — The Lone Aquarist's daily news for the marine aquarist">
    </h1>
    {% else %}
    <div class="banner-fallback">
      <p class="kicker">The Lone Aquarist's</p>
      <h1 class="name">Daily Dive</h1>
      <p class="tagline">Your daily news for the marine aquarist.</p>
    </div>
    {% endif %}
    <p class="dateline">{{ issue.date | datefmt('full') }} · {{ issue.items|length }} item{{ '' if issue.items|length == 1 else 's' }}</p>
  </header>

  {% if issue.items %}
  <section class="intro">
    <p>Howdy, it's {{ brand.EDITOR }} again.</p>
    <p>Happy {{ issue.date | datefmt('weekday') }}, {{ brand.AUDIENCE }}, and welcome back to Daily Dive.</p>
    <p class="lead-in">Here are the biggest things worth knowing today:</p>
    <ul>
      {% for line in highlights %}
      <li>{{ line }}</li>
      {% endfor %}
      {% if highlights_plus %}
      <li class="plus">{{ highlights_plus }}</li>
      {% endif %}
    </ul>
    <p>Let's <em>dive</em> into the news touching our hobby&hellip;</p>
  </section>
  {% else %}
    <p class="empty">Nothing new in the feeds this morning.</p>
  {% endif %}

  <div class="sections">
    {% for title, slug, items in sections %}
    <section class="card sec-{{ slug }}">
      <h2><span>{{ title }}</span><span class="count">{{ items|length }}</span></h2>
      <ul class="items">
        {% for item in items %}
        <li class="item">
          <a class="headline" href="{{ item.url }}" rel="noopener nofollow external">{{ item.title }}</a>
          {% if item.extra.gist %}
          <p class="gist">{{ item.extra.gist }}</p>
          {% endif %}
          <p class="credit">
            {% if item.extra.beat %}<span class="beat">{{ item.extra.beat }}</span>{% endif %}
            {% if item.extra.duration_s %}<span class="runtime">{{ item.extra.duration_s | runtime }}</span>{% endif %}
            {% if item.extra.similar %}<span class="alsoran">+{{ item.extra.similar }} similar</span>{% endif %}
            <span class="source">{{ item.source_name }}</span>
            {% if item.author %}<span>· {{ item.author }}</span>{% endif %}
            <span>· {{ item.published_at | datefmt('short') }}</span>
            <span>· {{ item.url | host }}</span>
          </p>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  </div>

  <footer>
    {% if issue.outlets %}
    <p>
      Every item above links to its source. Today's reporting comes from
      {% for outlet in issue.outlets %}{{ outlet }}{% if not loop.last %}, {% endif %}{% endfor %}.
      Headlines and links belong to them; go read the originals.
    </p>
    {% endif %}
    <p>
      <em>Daily Dive</em> is an automated digest that links to reporting it does not own.
      See <a href="/about.html">about &amp; sourcing policy</a> for how sources are selected
      and how to request removal.
    </p>
    <p>Generated {{ generated_at | datefmt('stamp') }}.</p>
  </footer>

</div>
</body>
</html>
