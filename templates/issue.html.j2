<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Daily Dive — {{ issue.date.strftime('%B %-d, %Y') }}</title>
<style>
  :root {
    --bg: #fbfaf7;
    --surface: #ffffff;
    --ink: #17211f;
    --muted: #5d6b68;
    --rule: #e2e0d9;
    --accent: #0f6f6c;
    --accent-soft: #e6f1f0;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #101614;
      --surface: #161d1b;
      --ink: #e8ece9;
      --muted: #93a29e;
      --rule: #263230;
      --accent: #5fc9c2;
      --accent-soft: #16302e;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    -webkit-text-size-adjust: 100%;
  }
  .wrap { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }

  header.masthead { border-bottom: 2px solid var(--ink); padding-bottom: 1rem; margin-bottom: .5rem; }
  .brand { font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 0; }
  h1 { font-size: 2.1rem; line-height: 1.15; margin: .3rem 0 .4rem; letter-spacing: -.02em; }
  .dateline { color: var(--muted); font-size: .9rem; margin: 0; }

  section { margin-top: 2.5rem; }
  h2 {
    font-size: .82rem; text-transform: uppercase; letter-spacing: .1em;
    color: var(--accent); margin: 0 0 .85rem;
    padding-bottom: .4rem; border-bottom: 1px solid var(--rule);
  }

  ul.items { list-style: none; margin: 0; padding: 0; }
  li.item { padding: .85rem 0; border-bottom: 1px solid var(--rule); }
  li.item:last-child { border-bottom: none; }
  .item a.headline { color: var(--ink); text-decoration: none; font-weight: 600; }
  .item a.headline:hover { color: var(--accent); text-decoration: underline; }
  .credit { display: block; margin-top: .3rem; font-size: .84rem; color: var(--muted); }
  .credit .source { color: var(--accent); font-weight: 600; }
  .badge {
    display: inline-block; font-size: .7rem; padding: .05rem .4rem; border-radius: 3px;
    background: var(--accent-soft); color: var(--accent); margin-left: .35rem;
  }

  footer {
    margin-top: 3.5rem; padding-top: 1.25rem; border-top: 1px solid var(--rule);
    font-size: .85rem; color: var(--muted);
  }
  footer a { color: var(--accent); }
  .empty { color: var(--muted); font-style: italic; padding: 2rem 0; }
</style>
</head>
<body>
<div class="wrap">

  <header class="masthead">
    <p class="brand">The Lone Aquarist</p>
    <h1>The Daily Dive</h1>
    <p class="dateline">{{ issue.date.strftime('%A, %B %-d, %Y') }} · {{ issue.items|length }} item{{ '' if issue.items|length == 1 else 's' }}</p>
  </header>

  {% if not issue.items %}
    <p class="empty">Nothing new in the feeds this morning.</p>
  {% endif %}

  {% for title, items in sections %}
  <section>
    <h2>{{ title }}</h2>
    <ul class="items">
      {% for item in items %}
      <li class="item">
        <a class="headline" href="{{ item.url }}" rel="noopener nofollow external">{{ item.title }}</a>
        <span class="credit">
          <span class="source">{{ item.source_name }}</span>
          {% if item.author %}· {{ item.author }}{% endif %}
          · {{ item.published_at.strftime('%b %-d') }}
          <span class="badge">{{ item.url | host }}</span>
        </span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}

  <footer>
    {% if issue.outlets %}
    <p>
      Every item above links to its source. Today's reporting comes from
      {% for outlet in issue.outlets %}{{ outlet }}{% if not loop.last %}, {% endif %}{% endfor %}.
      Headlines and links belong to them; go read the originals.
    </p>
    {% endif %}
    <p>
      <em>The Daily Dive</em> is an automated digest that links to reporting it does not own.
      See <a href="/about.html">about &amp; sourcing policy</a> for how sources are selected
      and how to request removal.
    </p>
    <p>Generated {{ generated_at.strftime('%Y-%m-%d %H:%M %Z') }}.</p>
  </footer>

</div>
</body>
</html>
