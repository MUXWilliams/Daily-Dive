{#-
  The issue, as email.

  A separate template from issue.html.j2 on purpose. That one is built on CSS
  custom properties, color-mix() and position:sticky — none of which survive
  Outlook, and the first two do not survive Gmail either. Reusing it would
  produce a page that looks right in a browser preview and arrives unstyled.

  Rules this file obeys, all of them the hard-won kind:

  * Tables for layout. No flex, no grid, no float.
  * Every style inlined on the element. Gmail's clipping and some Outlook
    configurations discard a <style> block, and a digest that arrives as
    unstyled text is a digest nobody reads.
  * Literal hex, never a variable. The palette matches the site but is resolved
    here because email has no var().
  * Absolute URLs everywhere. A relative href is meaningless in an inbox.
  * No web fonts, no background images, no images that carry meaning. The
    masthead has alt text and the layout holds without it.
  * 600px, the width every client has agreed on for twenty years.

  Unsubscribe is deliberately absent: the sending service appends its own, and
  a second one would be confusing at best. Nothing here fakes that link.
-#}
{%- set C = {
  'community':  ('#364a8f', '#eceef7'),
  'industry':   ('#0a6360', '#ecf4f3'),
  'husbandry':  ('#2a6234', '#edf3ee'),
  'livestock':  ('#8a5512', '#f6f1e8'),
  'wild-reefs': ('#1a5182', '#eaeff5'),
  'events':     ('#4b4a6e', '#eeedf4'),
  'elsewhere':  ('#545e69', '#f2f3f5'),
  'resource':   ('#1f5f6d', '#eaf2f4'),
} -%}
{%- set INK = '#16191d' -%}
{%- set SOFT = '#545e69' -%}
{%- set FAINT = '#8b959f' -%}
{%- set RULE = '#e4e8eb' -%}
{%- set LINK = '#0b5fbe' -%}
{%- set FONT = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ brand.PUBLICATION }} — {{ issue.date | datefmt('full') }}</title>
</head>
<body style="margin:0; padding:0; background:#f6f7f8; -webkit-text-size-adjust:100%;">

{# The line a client shows beside the subject. Without it, clients scrape the
   first text they find, which would be the masthead's alt text. #}
<div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent; height:0; width:0;">
  {{ preheader }}
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f6f7f8;">
<tr><td align="center" style="padding:20px 12px 40px;">

{#- Fluid table with a max-width, not a fixed 600. A table with width="600"
    inside a table cell makes the cell shrink-to-fit to 600px, and max-width
    cannot pull it back — the whole email then scrolls sideways on a phone.
    Measured in Chromium at 390px: 624px of document against a 390px viewport.

    Outlook ignores max-width entirely, so it gets a fixed 600px wrapper of its
    own through the conditional comment. Every other client ignores that. -#}
<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:600px; background:#ffffff; border-radius:10px;">

  {# ------------------------------------------------------------ masthead #}
  <tr><td style="padding:0;">
    <a href="{{ brand.SITE_URL }}/" style="text-decoration:none;">
      <img src="{{ brand.SITE_URL }}/assets/masthead.png" width="600" alt="{{ brand.PUBLICATION }} — {{ brand.SITE_NAME }}. {{ brand.TAGLINE }}"
        style="display:block; width:100%; max-width:600px; height:auto; border:0; border-radius:10px 10px 0 0;">
    </a>
  </td></tr>

  <tr><td style="padding:14px 22px 0; font-family:{{ FONT }}; font-size:12px; line-height:1.5; color:{{ FAINT }};">
    {{ issue.date | datefmt('full') }} · {{ issue.items|length }} item{{ '' if issue.items|length == 1 else 's' }}
    · <a href="{{ brand.SITE_URL }}/" style="color:{{ LINK }}; text-decoration:underline;">read on the web</a>
  </td></tr>
  <tr><td style="padding:10px 22px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td style="border-top:1px solid {{ RULE }}; font-size:0; line-height:0;">&nbsp;</td>
    </tr></table>
  </td></tr>

  {# ---------------------------------------------------------- highlights #}
  {% if highlights %}
  <tr><td style="padding:16px 22px 0; font-family:{{ FONT }}; font-size:15px; line-height:1.5; color:{{ INK }};">
    <strong style="font-size:13px; letter-spacing:.06em; text-transform:uppercase; color:{{ FAINT }};">This week</strong>
    <ul style="margin:8px 0 0; padding:0 0 0 20px;">
      {% for line in highlights %}
      <li style="margin:0 0 5px; color:{{ SOFT }};">{{ line }}</li>
      {% endfor %}
      {% if highlights_plus %}
      <li style="margin:0; color:{{ FAINT }};">{{ highlights_plus }}</li>
      {% endif %}
    </ul>
  </td></tr>
  {% endif %}

  {# ------------------------------------------------------------ sections #}
  {% for title, slug, items in sections %}
  {% set hue = C.get(slug, C['elsewhere'])[0] %}
  {% set tint = C.get(slug, C['elsewhere'])[1] %}
  <tr><td style="padding:18px 22px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ tint }}; border-radius:8px;">
      <tr><td style="background:{{ hue }}; border-radius:8px 8px 0 0; padding:9px 14px; font-family:{{ FONT }}; font-size:14px; font-weight:bold; color:#ffffff;">
        {{ title }}
        <span style="float:right; font-size:12px; font-weight:bold; color:#ffffff; opacity:.75;">{{ items|length }}</span>
      </td></tr>
      <tr><td style="padding:4px 14px 12px;">
        {% for item in items %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td style="padding:10px 0 {{ '0' if loop.last else '10px' }}; {{ '' if loop.last else 'border-bottom:1px solid ' ~ RULE ~ ';' }} font-family:{{ FONT }};">
            <a href="{{ item.url }}" style="display:block; font-size:15px; font-weight:bold; line-height:1.32; color:{{ INK }}; text-decoration:none;">{{ item.title }}</a>
            {% if item.extra.gist %}
            <div style="margin:5px 0 0; font-size:14px; line-height:1.48; color:{{ SOFT }};">{{ item.extra.gist }}</div>
            {% endif %}
            <div style="margin:6px 0 0; font-size:12px; line-height:1.5; color:{{ FAINT }};">
              {% if item.extra.duration_s %}{{ item.extra.duration_s | runtime }} · {% endif %}
              <span style="color:{{ hue }}; font-weight:bold;">{{ item.source_name }}</span>
              {% if item.author and item.author != item.source_name %} · {{ item.author }}{% endif %}
              · {{ item.published_at | datefmt('short') }}
              · {{ item.url | host }}
            </div>
          </td></tr>
        </table>
        {% endfor %}
      </td></tr>
    </table>
  </td></tr>
  {% endfor %}

  {# ------------------------------------------------------------ resource #}
  {% if resource %}
  {% set hue = C['resource'][0] %}
  {% set tint = C['resource'][1] %}
  <tr><td style="padding:18px 22px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ tint }}; border-radius:8px;">
      <tr><td style="background:{{ hue }}; border-radius:8px 8px 0 0; padding:9px 14px; font-family:{{ FONT }}; font-size:14px; font-weight:bold; color:#ffffff;">
        Resource
      </td></tr>
      <tr><td style="padding:12px 14px 14px; font-family:{{ FONT }};">
        {% if thumb %}
        <a href="{{ resource.url }}" style="text-decoration:none;">
          <img src="{{ thumb }}" width="556" alt="{{ resource.title }} — {{ resource.source_name }}"
            style="display:block; width:100%; max-width:556px; height:auto; border:0; border-radius:6px;">
        </a>
        {% endif %}
        <a href="{{ resource.url }}" style="display:block; margin-top:{{ '10px' if thumb else '0' }}; font-size:16px; font-weight:bold; line-height:1.3; color:{{ INK }}; text-decoration:none;">{{ resource.title }}</a>
        {% if resource.extra.gist %}
        <div style="margin:5px 0 0; font-size:14px; line-height:1.48; color:{{ SOFT }};">{{ resource.extra.gist }}</div>
        {% endif %}
        <div style="margin:6px 0 0; font-size:12px; line-height:1.5; color:{{ FAINT }};">
          {% if resource.extra.duration_s %}{{ resource.extra.duration_s | runtime }} · {% endif %}
          <span style="color:{{ hue }}; font-weight:bold;">{{ resource.source_name }}</span>
          · {{ resource.published_at | datefmt('short') }}
          · {{ resource.url | host }}
        </div>
      </td></tr>
    </table>
  </td></tr>
  {% endif %}

  {# -------------------------------------------------------------- footer #}
  <tr><td style="padding:24px 22px 24px; font-family:{{ FONT }}; font-size:12px; line-height:1.6; color:{{ FAINT }};">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td style="border-top:1px solid {{ RULE }}; font-size:0; line-height:0; padding-bottom:12px;">&nbsp;</td>
    </tr></table>
    {% if issue.outlets %}
    <p style="margin:0 0 8px;">
      Every item above links to its source. This week's reporting comes from
      {% for outlet in issue.outlets %}{{ outlet }}{% if not loop.last %}, {% endif %}{% endfor %}.
      Headlines and links belong to them; go read the originals.
    </p>
    {% endif %}
    <p style="margin:0 0 8px;">
      <a href="{{ brand.SITE_URL }}/archive.html" style="color:{{ LINK }};">Back issues</a> ·
      <a href="{{ brand.SITE_URL }}/about.html" style="color:{{ LINK }};">About &amp; sourcing policy</a> ·
      <a href="mailto:{{ brand.CONTACT_EMAIL }}" style="color:{{ LINK }};">{{ brand.CONTACT_EMAIL }}</a>
    </p>
    <p style="margin:0;">
      <em>{{ brand.PUBLICATION }}</em> is an automated digest from
      {{ brand.SITE_NAME }} that links to reporting it does not own.
      Edited by {{ brand.EDITOR }}.
    </p>
  </td></tr>

</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>

</body>
</html>
